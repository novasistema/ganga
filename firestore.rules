rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Products catalog (Dropshipping items)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Customer orders & budgets
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Registered clients / buyers directory
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Supplier purchase orders (Órdenes de Compra a Proveedores)
    match /supplier_orders/{orderId} {
      allow read, write: if true;
    }

    // Store & payment settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Registered resellers & sales representatives
    match /resellers/{resellerId} {
      allow read, write: if true;
    }

    // Push & in-app notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
