{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "NUVOH catalog product with wholesale pricing tiers and specifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hook": { "type": "string" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "code": { "type": "string" },
        "brand": { "type": "string" },
        "priceUnit": { "type": "number" },
        "priceTiers": { "type": "object" },
        "badges": { "type": "array" },
        "specs": { "type": "array" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "featured": { "type": "boolean" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "sku", "priceUnit", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Wholesale store purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "businessName": { "type": "string" },
        "documentId": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "shippingMethod": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "phone", "shippingAddress", "city", "total", "status"]
    },
    "Deal": {
      "title": "Deal",
      "description": "CRM commercial deal and pipeline stage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "stage": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "assignedSalesperson": { "type": "string" }
      },
      "required": ["customerName", "phone", "stage", "totalAmount"]
    },
    "Client": {
      "title": "Client",
      "description": "Wholesale client and distributor profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "businessName": { "type": "string" },
        "cuitOrDni": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "tier": { "type": "string" },
        "totalSpent": { "type": "number" },
        "orderCount": { "type": "number" },
        "notes": { "type": "string" },
        "lastContact": { "type": "string" }
      },
      "required": ["name", "businessName", "phone", "tier"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Customer interaction log or note in CRM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "dealId": { "type": "string" },
        "type": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "note", "createdAt"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Company data and payment methods configuration",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "legalName": { "type": "string" },
        "cuit": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "minimumOrder": { "type": "number" },
        "bankName": { "type": "string" },
        "accountHolder": { "type": "string" },
        "cbu": { "type": "string" },
        "alias": { "type": "string" },
        "cardPaymentsEnabled": { "type": "boolean" },
        "installmentsAllowed": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyName", "legalName", "cuit", "cbu", "alias"]
    },
    "SupplierSource": {
      "title": "SupplierSource",
      "description": "Connected wholesale supplier e-commerce website",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "platform": { "type": "string" },
        "skuPrefix": { "type": "string" },
        "defaultMarginPercent": { "type": "number" },
        "status": { "type": "string" },
        "lastSyncAt": { "type": "string" },
        "productsCount": { "type": "number" }
      },
      "required": ["id", "name", "url", "platform", "skuPrefix", "defaultMarginPercent"]
    },
    "SupplierProduct": {
      "title": "SupplierProduct",
      "description": "Scraped or synchronized product from wholesale supplier with markup and publishing state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "originalTitle": { "type": "string" },
        "sanitizedTitle": { "type": "string" },
        "originalSku": { "type": "string" },
        "internalSku": { "type": "string" },
        "category": { "type": "string" },
        "costArs": { "type": "number" },
        "previousCostArs": { "type": "number" },
        "costChangeDelta": { "type": "number" },
        "stock": { "type": "number" },
        "image": { "type": "string" },
        "marginPercent": { "type": "number" },
        "fixedMarkupArs": { "type": "number" },
        "roundingRule": { "type": "string" },
        "finalSalePrice": { "type": "number" },
        "status": { "type": "string" },
        "publishedProductId": { "type": "string" },
        "lastCheckedAt": { "type": "string" },
        "hasCostChanged": { "type": "boolean" }
      },
      "required": ["id", "supplierId", "sanitizedTitle", "internalSku", "costArs", "finalSalePrice", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog items"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders created by buyers and tracked in CRM"
    },
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Sales pipeline commercial opportunities"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Wholesale client directory"
    },
    "/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "CRM interaction notes and history"
    },
    "/settings/{settingId}": {
      "schema": "CompanySettings",
      "description": "Company profile and payment method settings"
    },
    "/suppliers/{supplierId}": {
      "schema": "SupplierSource",
      "description": "Connected wholesale supplier web sources"
    },
    "/supplier_products/{productId}": {
      "schema": "SupplierProduct",
      "description": "Imported and synchronized supplier catalog items"
    }
  }
}
